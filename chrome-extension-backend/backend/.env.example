# Stack3 core API configuration.
# Copy to .env for local development / docker-compose; in production set these as platform secrets.
# Made by Yash Jain with passion.

# ---------- App ----------
ENV=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
API_BASE_URL=http://localhost:8000
# The website (Next.js) origin; login cookies and redirects use it
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
# Chrome extension IDs allowed to call the API, e.g. ["abcdefghijklmnopabcdefghijklmnop"]
CHROME_EXTENSION_IDS=[]

# ---------- Database / cache ----------
# Supabase: Project > Connect > "Session pooler" URI (port 5432, IPv4). Not the direct db.<ref>.supabase.co host
# (IPv6 only) and not the transaction pooler on 6543. Change the scheme to postgresql+asyncpg:// and add ?ssl=require.
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
# Per API worker (2 workers): 2 x (3 + 2) = 10 connections, under Supabase free tier's pool of 15
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# docker-compose overrides REDIS_URL with the container address
REDIS_URL=redis://localhost:6379/0
DB_SCHEMA=chrome

# ---------- Tokens ----------
# Leave JWT_PRIVATE_KEY empty in development: a key is created automatically.
# Production: python -m scripts.generate_jwt_key
JWT_ISSUER=https://api.stack3.xyz
JWT_PRIVATE_KEY=
JWT_KEY_ID=stack3-2026-10
ACCESS_TOKEN_TTL_SECONDS=1800
# false for local http://localhost testing; must be true in production (https)
COOKIE_SECURE=false
# strict for local. Set none on the public API when the website is on Netlify (a different domain). Requires COOKIE_SECURE=true.
COOKIE_SAMESITE=strict

# Required in production, random 32+ chars each:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# OTP_PEPPER=
# INTERNAL_SERVICE_KEY=

# ---------- Email: Gmail SMTP ----------
# Gmail needs 2-Step Verification + an App Password (16 chars, no spaces).
# Leave SMTP_* empty in development to print login codes in the API logs instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Gmail requires FROM to be the same Gmail address (or a verified alias)
EMAIL_FROM=Stack3 Security <your.address@gmail.com>

# ---------- Threat graph: TigerGraph Savanna ----------
# Host = the workspace's nginx host. Username/password = in-database user (superuser on global) for setup;
# SECRET = created with `CREATE SECRET` on graph stack3, used at runtime for tokens. See graph/README.md
TIGERGRAPH_HOST=https://tg-<workspace-id>.tg-<org-number>.i.tgcloud.io
TIGERGRAPH_GRAPH=stack3
TIGERGRAPH_USERNAME=
TIGERGRAPH_PASSWORD=
TIGERGRAPH_SECRET=
# Savanna control-plane API key: admin scripts only, not needed to run the API
TIGERGRAPH_API_KEY=

# ---------- Payments: Dodo (test mode) ----------
DODO_ENVIRONMENT=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_TRIAL_DAYS=30
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_TEAM_MONTHLY=
DODO_PRODUCT_TEAM_YEARLY=
# Seat add-ons (Products > Add-Ons), attached to the Team products; each unit = one extra seat beyond the 3 included
DODO_ADDON_TEAM_SEAT_MONTHLY=
DODO_ADDON_TEAM_SEAT_YEARLY=

# ---------- Chrome checks ----------
# Etherscan API v2 key (one key works across chains). RPC is an Ethereum mainnet URL from Alchemy or Infura.
ETHERSCAN_API_KEY=
RPC_URL_ETHEREUM=
# Optional. Without it, script check still flags packages and URLs already in the threat graph.
SOCKET_API_KEY=
# Public registration lookup for young lookalike domains. Leave true.
RDAP_REMOTE=true
